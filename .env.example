# Redirect URLs (Authentication → URL Configuration):
#   Este repo: `npm run dev` e `npm run preview` usam porta 3000 (ver package.json)
#     http://localhost:3000
#     http://localhost:3000/auth/callback
#
# Produção: defina a origem do site (sem barra final) para OAuth redirectTo no build de produção.
#   VITE_SITE_URL=https://app.seudominio.com

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_YOUR_REAL_ANON_KEY_FROM_SUPABASE_DASHBOARD
