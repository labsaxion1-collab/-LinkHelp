# =============================================================================
# MODELO — o Vite NÃO carrega este ficheiro em runtime.
# Copie para `.env` ou `.env.local` na raiz e preencha com valores reais.
# =============================================================================
#
# Supabase → Project Settings → API
#   VITE_SUPABASE_URL   = Project URL
#   VITE_SUPABASE_ANON_KEY = anon public (JWT eyJ…)
#
# Redirect URLs (Authentication → URL Configuration):
#   Este repo: `npm run dev` e `npm run preview` usam porta 3000 (ver package.json)
#     http://localhost:3000
#     http://localhost:3000/auth/callback
#
# OAuth: default is PKCE (recommended). Only if code_verifier / localStorage issues persist, try:
#   VITE_SUPABASE_AUTH_FLOW=implicit
#
# Produção: defina a origem do site (sem barra final) para OAuth redirectTo no build de produção.
#   VITE_SITE_URL=https://app.seudominio.com
#
# Google Maps (Maps JavaScript API) — obrigatório para o mapa em /map
#   Vercel → Project → Settings → Environment Variables:
#     VITE_GOOGLE_MAPS_PLATFORM_KEY=sua_chave
#   No Google Cloud Console, restrinja a chave por referrer HTTP:
#     https://link-help.vercel.app/*
#     http://localhost:3000/*
#   Não use GOOGLE_MAPS_PLATFORM_KEY no frontend Vite; só VITE_* é exposto ao browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_YOUR_REAL_ANON_KEY_FROM_SUPABASE_DASHBOARD
# VITE_SITE_URL=https://app.seudominio.com
# Dev/preview: simulate host routing (www | app | flux) — ignored in production.
# VITE_LINKHELP_HOST_PROFILE=app
# VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Stripe — helper LinkCredits checkout (Vercel API routes)
#   VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
#   STRIPE_SECRET_KEY=sk_live_...          (server only — Vercel env)
#   STRIPE_WEBHOOK_SECRET=whsec_...        (server only — Stripe webhook signing)
#   SUPABASE_SERVICE_ROLE_KEY=...          (webhook credits wallet)

# Web Push (optional) — public VAPID key; private key only in supabase/functions/send-push secrets.
#   VITE_VAPID_PUBLIC_KEY=

# Credit refunds — client response deadline before auto-refund (hours).
# Stored in Supabase `platform_settings.response_deadline_hours` (default 48).
#   RESPONSE_DEADLINE_HOURS=48
#
# Cron: schedule edge function `process-credit-refunds` hourly (service_role or CRON_SECRET).
#   supabase functions deploy process-credit-refunds
#   curl -X POST "$SUPABASE_URL/functions/v1/process-credit-refunds" \
#     -H "Authorization: Bearer $SUPABASE_SERVICE_ROLE_KEY"
